<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTP is intentionally allowed: some low-bandwidth sites still have no HTTPS endpoint. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
